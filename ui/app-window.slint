import { Button, HorizontalBox, VerticalBox, AboutSlint, StandardButton } from "std-widgets.slint";

export component AbtSlint inherits Window {
    height: 175px;
    AboutSlint {}
}

export component AppWindow inherits Window {
    title: @tr("PuyoPLN");
    min-width: 300px;
    min-height: 300px;

    in property <image> plane_view;
    in property <image> plane_background;

    callback display_about_slint();
    callback load_project(string) -> bool;
    callback open_project_dialog() -> string;
    callback place_tile(int, int, int);

    MenuBar {
        Menu {
            title: @tr("Project");
            MenuItem {
                title: @tr("Load Project");
                activated => {
                    let project = root.open_project_dialog();
                    if project != "" {
                        if !root.load_project(project) {
                            // TODO: This should be a popup.
                            debug("Load failed");
                        }
                    }
                };
            }
        }

        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New Plane");
            }
        }

        Menu {
            title: @tr("About");
            MenuItem {
                title: @tr("About Slint");
                activated => root.display_about_slint();
            }
        }
    }

    HorizontalBox {
        VerticalBox {
            alignment: start;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 0px;
            width: 2.5%;
            Button {
                height: 36px;
                text: @tr("pla");
                Tooltip {
                    text: @markdown("Plane Editor");
                }
            }

            Button {
                height: 36px;
                text: @tr("art");
                Tooltip {
                    text: @markdown("Art Editor");
                }
            }

            Button {
                height: 36px;
                text: @tr("pal");
                Tooltip {
                    text: @markdown("Palette Editor");
                }
            }
        }

        Rectangle {
            clip: true;
            background: darkgrey;

            plane-area := TouchArea {
                property<float> zoom: 1.0;
                property<bool> middle_click;
                property<length> prev_mouse_x;
                property<length> prev_mouse_y;
                property<length> view_x;
                property<length> view_y;
                property<length> view_w: plane_view.width * 1px;
                property<length> view_h: plane_view.height * 1px;

                plane-image := Image {
                    vertical-alignment: top;
                    source: plane_view;
                    image-fit: cover;
                    image-rendering: pixelated;
                    x: plane-area.view_x;
                    y: plane-area.view_y;
                    width: plane-area.view_w * plane-area.zoom;
                    height: plane-area.view_h * plane-area.zoom;

                    TouchArea {
                        property<bool> left_click;

                        tile-cursor := Rectangle {
                            background: white;
                            opacity: 0.7;
                            width: 8px * plane-area.zoom;
                            height: 8px * plane-area.zoom;
                        }
    
                        Timer {
                            interval: 0.016s; // TODO: This should be tied to framerate?
                            triggered() => {
                                let scale_down = 8px * plane-area.zoom;
                                let oldx = tile-cursor.x;
                                let oldy = tile-cursor.y;

                                tile-cursor.x = (parent.mouse-x - Math.mod(parent.mouse-x, tile-cursor.width));
                                tile-cursor.y = (parent.mouse-y - Math.mod(parent.mouse-y, tile-cursor.height));

                                if (oldx != tile-cursor.x || oldy != tile-cursor.y) && parent.left_click {
                                    let x = Math.round(tile-cursor.x / scale_down);
                                    let y = Math.round(tile-cursor.y / scale_down);
                                    debug(x, y);
                                    root.place_tile(8, x, y);
                                }
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == down {
                                if event.button == PointerEventButton.left {
                                    let scale_down = 8px * plane-area.zoom;
                                    self.left_click = true;
                                    let x = Math.round(tile-cursor.x / scale_down);
                                    let y = Math.round(tile-cursor.y / scale_down);
                                    debug(x, y);
                                    root.place_tile(8, x, y);
                                }
                            } else if event.kind == up {
                                if event.button == PointerEventButton.left {
                                    self.left_click = false;
                                }
                            }

                            plane-area.pointer-event(event);
                        }
                        moved => {
                            plane-area.moved();
                        }
                    }
                }


                moved => {
                    // Do stuff with new mouse

                    // Transform Image X & Y
                    if self.middle_click && self.prev_mouse_x != -1px && self.prev_mouse_y != -1px {
                        self.view_x += (self.mouse-x - self.prev_mouse_x);
                        self.view_y += (self.mouse-y - self.prev_mouse_y);
                    }

                    self.prev_mouse_x = self.mouse-x;
                    self.prev_mouse_y = self.mouse-y;
                }
                scroll-event(event) => {
                    let scale_amount = (event.delta-y / 600px);
                    let scale = (self.zoom + self.zoom * scale_amount) / self.zoom;
                    self.zoom = self.zoom + self.zoom * scale_amount;


                    debug(scale);

                    self.view_x = self.mouse-x - (self.mouse-x - self.view_x) * scale;
                    self.view_y = self.mouse-y - (self.mouse-y - self.view_y) * scale;

                    accept
                }
                pointer-event(event) => {
                    if event.kind == down {
                        if event.button == PointerEventButton.middle {
                            debug("press");
                            self.middle_click = true;
                            self.prev_mouse_x = -1px;
                            self.prev_mouse_y = -1px;
                        }
                    } else if event.kind == up {
                        if event.button == PointerEventButton.middle {
                            debug("release");
                            self.middle_click = false;
                        }
                    }
                }
            }
        }

        //Button {
        //    text: "plane editor";
        //}



        VerticalBox {
            padding-left: 0px;
            padding-right: 0px;
            padding-bottom: 0px;
            padding-top: 0px;
            width: 15%;
            Button {
                height: 20%;
                text: "tile properties";
            }

            Button {
                text: "tiles";
            }
        }
    }
}
